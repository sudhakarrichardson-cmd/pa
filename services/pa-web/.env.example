# pa-web settings — copy to .env on the server and fill in (never commit the real file)
PORT=8095

# Supabase stack Postgres, reached over the supabase_default Docker network.
# NOTE: this stack's Postgres listens on 5433 inside the containers.
# DB_USER is the app role created by database/migrations/021-survey-schema.sql;
# its password is set on the server and copied here — never typed in chat.
DB_HOST=db
DB_PORT=5433
DB_NAME=postgres
DB_USER=survey_app
DB_PASSWORD=

# --- Per-user logins (Supabase Auth) — same aliases as textiles-api ---
# Copy the stack's JWT signing secret into THIS env under a local name
# (run on the server; the value never goes in chat):
#   echo "SUPABASE_JWT=$(grep -oP '^JWT_SECRET=\K.*' /root/supabase-selfhost/docker/.env)" >> .env
SUPABASE_JWT=
# Anon key from the same stack .env (ANON_KEY) — used server-side only:
#   echo "SUPABASE_ANON_KEY=$(grep -oP '^ANON_KEY=\K.*' /root/supabase-selfhost/docker/.env)" >> .env
SUPABASE_ANON_KEY=
# GoTrue endpoint inside the Docker network (Kong service of the stack)
SUPABASE_AUTH_URL=http://kong:8000

# Staff & HR (admin / HR only): pa-web forwards login requests to the
# existing platform-admin container over the Docker network. pa-web holds
# NO Auth service key. APP_DOMAIN must equal platform.apps.domain for app
# 'survey' — platform-admin uses it to pick the app.
PLATFORM_ADMIN_URL=http://platform-admin:8092
APP_DOMAIN=pa.plotfarms.com

# Key that encrypts Aadhaar, PAN and bank account numbers in employee
# profiles. Generate it ON THE SERVER, once, and never change it afterwards
# (numbers saved with the old key could no longer be read):
#   echo "STAFF_DATA_KEY=$(openssl rand -hex 32)" >> .env
# Those three fields are optional; without a key the app refuses to save
# them instead of storing them in plain text. Back this key up with the DB.
STAFF_DATA_KEY=

# Where A10 sample photos are stored inside the container
# (docker-compose mounts ./uploads here).
UPLOAD_DIR=/data/uploads

# Telegram bot token — from @BotFather. Required for the Telegram
# webhook (/api/telegram/webhook). Never commit the real value.
TELEGRAM_BOT_TOKEN=

# MiniMax API key — powers the AI helper in the Telegram bot.
# Copy from /root/textile/services/ai-helper/.env (same key).
MINIMAX_API_KEY=

# --- PA messaging layer (migration 023, router.js / apps.js) ---
# Shared secret the platform gateways (wa-gateway / telegram-gateway)
# send as the x-pa-secret header when POSTing consumer messages to
# /api/pa/inbound. Generate ON THE SERVER; without it the route
# refuses every request (503).
PA_INBOUND_SECRET=
# One shared secret per registered app — PA sends it as x-pa-secret
# when calling that app's endpoint (check_availability / place_order /
# order_status). The registry (pa.app_registry.secret_env) stores only
# these variable NAMES; values live here only.
PA_APP_SECRET_TEXTILES=
PA_APP_SECRET_VEGIBOT=
PA_APP_SECRET_SCHEDULER=
PA_APP_SECRET_HELPLAWYER=
# Optional: platform ai-helper base URL (e.g. http://ai-helper:8093).
# The router's rule parser escalates unparsed free text to it; the
# helper returns { category, items } as data only and never writes.
AI_HELPER_URL=
